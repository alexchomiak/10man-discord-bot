# Streaming selfbot (Mode B) env example
#
# Copy to `streambot.env` and set real values; source it before running
# `MODE=streambot ./run.sh`. Never commit a real .env.
#
# IMPORTANT security note:
#   - SELF_BOT_TOKEN is a Discord USER-token (a selfbot), NOT a bot token.
#   - It is loaded from env, never written to disk, and redacted from all logs.
#   - Using a user-token violates Discord's ToS; use a dedicated/throwaway
#     account. Do NOT reuse a token that has access to sensitive channels.
#
# All variables are OPTIONAL unless marked (required).

# ---- Identity ---------------------------------------------------------------
# (required) A Discord USER token (selfbot), not a bot token.
SELF_BOT_TOKEN=

# Default guild for the stream (falls back to the invoking member's guild).
SBOT_GUILD_ID=

# Command prefix (default: $).
SBOT_COMMAND_PREFIX=$

# ---- Targeting --------------------------------------------------------------
# Default voice channel to join when the requester is not already in one.
# (Required for webhook-triggered streams; for command-triggered, the
# requester's current voice channel is used when they are in one.)
STREAM_CHANNEL_ID=

# ---- Video params -----------------------------------------------------------
# All optional; defaults shown.
STREAM_WIDTH=1920
STREAM_HEIGHT=1080
STREAM_FRAME_RATE=30
# Bitrate in kbps (e.g. 5000). The video lib accepts 'k'/'m' suffixes.
STREAM_BITRATE=5000
# h264 | h265 | vp8 | vp9 | av1   (h264 is the safe default for Discord)
VIDEO_CODEC=h264
# true selects VAAPI encoding and requires a VAAPI-capable ffmpeg plus a bound
# /dev/dri device. Hardware decode remains separately opt-in below.
HARDWARE_ACCEL=false
# Encoder selection: software or vaapi. When omitted, HARDWARE_ACCEL=true
# selects VAAPI (recommended for Intel Arc in Linux); false selects software.
# Docker also needs --device /dev/dri:/dev/dri and access to the host render
# group, commonly: --group-add "$(stat -c '%g' /dev/dri/renderD128)".
STREAMBOT_VIDEO_ENCODER=
STREAMBOT_VAAPI_DEVICE=/dev/dri/renderD128
# Optional hardware decode. Leave false for the most robust filter path; Arc
# VAAPI encoding handles the expensive stage already.
STREAMBOT_HARDWARE_DECODE=false
# Never download/decode above the 1080p output raster.
SBOT_SOURCE_MAX_HEIGHT=1080
# Bounded FFmpeg -> Discord cushion. 8 MiB is about 11-13 seconds at the
# default video+audio rate and lets VOD/live catch-up absorb short stalls.
SBOT_PIPELINE_BUFFER_MB=8
# Abort a stuck HTTP read so FFmpeg reconnect logic can recover.
SBOT_FFMPEG_READ_TIMEOUT_MS=15000

# ---- FFmpeg / yt-dlp --------------------------------------------------------
# Path to a system ffmpeg that includes libzmq (required by the video lib).
# Do NOT use the repo's bundled ffmpeg-static here — it is for the CS2 bot's
# audio path and may not include libzmq.
FFMPEG_PATH=ffmpeg
YTDLP_PATH=yt-dlp
YTDLP_FORMAT=bv*+ba/b
YTDLP_TIMEOUT_MS=20000
# Preferred AUDIO-language codes for multi-audio (DASH) sources,
# comma-separated, e.g. "en,es". Earlier = stronger preference. Default "en"
# (English first, then the rest). Empty string = no preference (the
# original/first-listed track is chosen). This only affects WHICH audio track
# is selected — it never changes the video track. Leave blank for "no pref".
SBOT_AUDIO_LANG=en

# ---- ShareTV ---------------------------------------------------------------
# Base URL of the iptv-share / ShareTV server (e.g. https://sharetv.example.com).
# Must be REACHABLE FROM THE BOT'S NETWORK — not just from your browser.
# It never needs to be a public URL; it just needs to be routable from wherever
# the bot process runs:
#   * bot in Docker (common case) on macOS/Windows, iptv-share on the host:
#       SHARETV_BASE=http://host.docker.internal:8080
#   * bot as a bare process on the same machine as iptv-share
#     (NOT when the bot is in Docker — localhost would point at the container):
#       SHARETV_BASE=http://localhost:8080
#   * bot in Docker, iptv-share in another container (Linux cluster):
#       SHARETV_BASE=http://iptv-share:8080   (compose service name, or the host LAN IP)
# With this set, `stream <slug>` and the webhook accept a bare ShareTV slug
# and resolve it via GET {base}/api/public/share/{slug}.
# Share-READ URLs that iptv-share pins to ITS OWN loopback
# (http://localhost:8080/api/public/stream/...) — whether from a share or a
# stream URL you paste into `$stream` directly — are rewritten to this base's
# host, so the bot never tries to play a dead localhost URL.
# If it is unset (or unreachable), /s/<slug> links are rejected with a hint
# instead of being handed to yt-dlp.
SHARETV_BASE=
# Optional comma-separated list of additional hosts to treat as ShareTV links.
# Only needed if you want http://some-random-domain/s/x to also route through
# iptv-share; usually leave blank.
SHARETV_ALLOW_HOSTS=

# ---- Grace period -----------------------------------------------------------
# After any stream ends (finish/error), the bot STAYS in the voice channel
# this long so viewers can chain the next stream without waiting for a
# re-join. A new $stream (or $join) within the window cancels the leave; an
# explicit $stop always leaves immediately.
# STREAM_GRACE_MS=300000

# ---- Outbound alerts (optional) ------------------------------------------
# Optional Discord SERVER webhook for success/error + stream-state feedback.
# The bot's Discord account is RESTRICTED and can no longer send channel
# messages, so all feedback is logged locally and, when this is set, also
# POSTed to this webhook (any channel of any server — it does not have to be
# the bot's). Errors and stream-state events only; fire-and-forget; token
# redacted. Leave blank to log locally only.
#TELEMETRY_WEBHOOK_URL=https://discord.com/api/webhooks/1234567890/abcdef

# ---- Webhook (inbound) ------------------------------------------------------
# (Required) HMAC-SHA256 shared secret used to sign every POST /webhook/stream.
# If unset, the webhook endpoint refuses all stream requests (HTTP 503) to
# avoid an accidental open door.
WEBHOOK_SECRET=
# Port the inbound webhook listens on. iptv-share uses 8080 in its own
# container; 8081 keeps the two clear on the same host.
STREAMBOT_WEBHOOK_PORT=8081
# Interface to bind. 0.0.0.0 so iptv-share can reach us across containers;
# on a single host you may prefer 127.0.0.1.
STREAMBOT_WEBHOOK_HOST=0.0.0.0

# ---- Optional PIA OpenVPN (Docker only) -------------------------------------
# Reuse PIA_USERNAME, PIA_PASSWORD and PIA_REGION from your existing PIA setup.
# All three must be non-empty; otherwise networking/startup remains unchanged.
# PIA_REGION is the bundle profile basename (without .ovpn); see docs/pia.md.
# Never commit credentials. Required additional docker run flags (documentation
# only): --cap-add NET_ADMIN --device /dev/net/tun:/dev/net/tun
# Keep the existing env file, command and -p 8081:8081.
PIA_USERNAME=
PIA_PASSWORD=
PIA_REGION=

# ---- Persistent go-live session --------------------------------------------
# One go-live session per voice channel. $stream queues real content in order;
# only the local placeholder is interrupted when real content arrives.
# Maximum WAITING items (the active item does not count). Default: 20.
STREAM_QUEUE_LIMIT=20
# Existing names/defaults remain valid:
# SBOT_FILLER_ON_JOIN=true (false keeps $join voice-only until the first $stream)
# SBOT_FILLER_DURATION_SEC=0 (derive max(2 * grace seconds, 300)); expiry ends
# only the placeholder piece, then STREAM_GRACE_MS starts before channel leave.
# STREAM_GRACE_MS=300000; SBOT_START_BURST_SEC=0; SBOT_AV_SYNC_BURST_SEC=0
# Keep both burst values at 0 for smooth frame pacing.
# STREAMBOT_PLAY_STREAM_TIMEOUT_MS=30000
# Idle holds the last frame with no media packets; new content keeps the same
# go-live track. $stop discards the queue, terminates the pipeline, and leaves.
